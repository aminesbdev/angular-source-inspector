{
  "name": "ngx-source-inspector",
  "version": "0.2.0",
  "description": "Hold Alt, hover an element of your Angular app to see which template line it comes from, Alt+click to open it in your editor. Development only.",
  "keywords": [
    "angular",
    "devtools",
    "open-in-editor",
    "inspector",
    "template",
    "source-location"
  ],
  "license": "MIT",
  "author": "Amine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aminesbdev/angular-source-inspector.git"
  },
  "homepage": "https://github.com/aminesbdev/angular-source-inspector#readme",
  "bugs": {
    "url": "https://github.com/aminesbdev/angular-source-inspector/issues"
  },
  "peerDependencies": {
    "@angular/common": ">=21.0.0 <23.0.0",
    "@angular/core": ">=21.0.0 <23.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "exports": {
    "./enable-source-locations": {
      "default": "./node/enable-source-locations.mjs"
    }
  },
  "schematics": "./schematics/collection.json",
  "sideEffects": false
}
